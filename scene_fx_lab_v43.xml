  <!-- Mode 0: untouched; 1: burst; 2: vortex; 3: reveal; 4: rainbow reveal; 5: spiral tornado burst; 6: fire / embers / heat distortion.
       GLSL signature is taken from official krpano 1.24 splatshader example.
       Animation runs via JavaScript changing custom uniform values. -->
  <action name="xyz_fx43_shader" type="glsl"><![CDATA[
    uniform float fx_mode;
    uniform float fx_progress;
    uniform float fx_power;
    uniform float fx_radius;

    float xyz_hash(vec3 p) {
      return fract(sin(dot(p, vec3(12.9898, 78.233, 37.719))) * 43758.5453);
    }
    vec3 xyz_palette(float t) {
      return 0.5 + 0.5 * cos(6.2831853 * (vec3(0.06,0.39,0.72) + t));
    }
    void splatshader(inout vec4 pos, inout mat3 mx, inout vec4 color) {
      if (fx_mode < 0.5) return;
      vec3 origin = pos.xyz;
      float radius = max(fx_radius, 0.001);
      float phase = clamp(fx_progress, 0.0, 1.0);
      float amount = max(fx_power, 0.0);
      float rnd = xyz_hash(origin);
      float rnd2 = xyz_hash(origin.zxy + vec3(17.1));
      float rnd3 = xyz_hash(origin.yzx + vec3(29.8));

      if (fx_mode < 1.5) {
        // BURST and reverse REBUILD: zero displacement at both ends.
        float expansion = sin(3.14159265 * phase);
        vec3 n = normalize(origin + vec3(0.0002, 0.0003, 0.0001));
        vec3 jitter = normalize(vec3(rnd - 0.5, rnd2 - 0.5, rnd3 - 0.5) + vec3(0.0001));
        vec3 dir = normalize(n * 0.62 + jitter * 0.75);
        pos.xyz += dir * (radius * 0.5 * amount) * expansion * (0.25 + rnd * 0.9);
        mx *= 1.0 - 0.30 * expansion;
        color.rgb += expansion * 0.20 * xyz_palette(rnd);
      } else if (fx_mode < 2.5) {
        // VORTEX and reverse REBUILD around model local Z axis.
        float expansion = sin(3.14159265 * phase);
        float angle = expansion * amount * (2.0 + 5.0 * rnd);
        float c = cos(angle), s = sin(angle);
        vec2 xy = origin.xy;
        vec2 rotated = vec2(c * xy.x - s * xy.y, s * xy.x + c * xy.y);
        pos.xy = rotated * (1.0 + expansion * amount * 0.25);
        pos.z = origin.z + expansion * radius * 0.24 * amount * (rnd2 - 0.5);
        color.rgb += expansion * 0.15 * xyz_palette(rnd2);
      } else if (fx_mode > 4.5 && fx_mode < 5.5) {
        // SPIRAL BURST: smooth, reversible helical displacement with curved flight paths.
        // sin(pi*phase) provides zero displacement at both ends; smoothstep creates a soft hold.
        float envelope = pow(max(sin(3.14159265 * phase), 0.0), 0.78);
        vec3 jitter = normalize(vec3(rnd-.5, rnd2-.5, rnd3-.5) + vec3(0.0001));
        float angle = envelope * amount * (3.0 + 7.0 * rnd) + phase * envelope * (2.0 + rnd2*4.0);
        float cs = cos(angle), sn = sin(angle);
        float spiralRadius = envelope * amount * radius * (0.20 + 0.55*rnd);
        vec2 p = origin.xy;
        vec2 shifted = vec2(cs * p.x - sn * p.y, sn * p.x + cs * p.y);
        vec2 swirl = vec2(cos(angle + rnd * 6.2831853), sin(angle + rnd * 6.2831853));
        pos.xy = shifted * (1.0 + envelope * 0.28 * amount) + spiralRadius * swirl + jitter.xy * spiralRadius * 0.35;
        pos.z = origin.z + envelope * amount * radius * (0.55 * (rnd3-0.5) + 0.24*sin(angle+rnd2*6.2831853));
        mx *= 1.0 - 0.22*envelope;
        color.rgb += envelope * 0.18 * xyz_palette(rnd2);
      } else if (fx_mode > 5.5 && fx_mode < 6.5) {
        // FIRE: glow, embers and mild heat-distortion on the model itself.
        float envelope = pow(max(sin(3.14159265 * phase), 0.0), 0.7);
        float h = clamp((origin.z + radius * 0.35) / max(radius * 0.9, 0.001), 0.0, 1.0);
        float edge = 1.0 - clamp(length(origin.xy) / max(radius * 0.55, 0.001), 0.0, 1.0);
        float flicker = 0.45 + 0.55 * sin(phase * 24.0 + rnd * 12.0 + origin.z * 0.03);
        float lick = pow(max(0.0, 1.0 - h), 1.8) * (0.45 + 0.55 * rnd2) + edge * 0.35;
        float hot = envelope * amount * lick * max(0.0, flicker);
        vec3 flame = mix(vec3(1.0,0.18,0.02), vec3(1.0,0.82,0.10), clamp(1.0 - h * 1.3 + rnd3 * 0.15, 0.0, 1.0));
        color.rgb = mix(color.rgb, max(color.rgb, flame), clamp(hot * 0.7, 0.0, 1.0));
        color.rgb += hot * 0.6 * vec3(1.0, 0.34 + 0.3*rnd, 0.08);
        vec2 wobble = vec2(sin(origin.z * 0.05 + phase * 12.0 + rnd * 6.2831853), cos(origin.z * 0.045 + phase * 10.0 + rnd2 * 6.2831853));
        pos.xy += wobble * radius * 0.015 * hot;
        pos.z += radius * 0.030 * hot * (0.4 + rnd3);
        mx *= 1.0 - 0.10 * hot;
      } else {
        // True per-splat radial reveal from the origin; final geometry unchanged.
        float d = length(origin);
        float edge = phase * radius * 1.2;
        float width = max(radius * 0.08, 0.01);
        float blend = smoothstep(d - width, d + width, edge);
        mx *= max(blend, 0.000001);
        if (fx_mode > 3.5) {
          float band = exp(-pow((d-edge) / width, 2.0));
          color.rgb += band * 0.65 * xyz_palette(d / radius * 3.0);
        }
      }
    }
  ]]></action>
