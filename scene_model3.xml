<krpano version="1.20">
    <!-- Путь относительный, без %SWFPATH% -->
    <include url="plugins/splats.js" />
    
    <scene name="scene_0" title="Zvon Splats">
        <view hlookat="0" vlookat="0" fov="90" />

        <!-- ВАЖНО: замени url ниже на относительный путь к файлу модели в папке model -->
        <splats 
            url="model/имя_твоего_файла.spz" 
            scale="1.0" 
            position="0 0 0" 
            rotation="0 0 0"
            visible="true"
            alpha="1.0"
        />

        <action name="onerror">
            trace('Ошибка загрузки модели: ', get(errormessage));
        </action>
    </scene>

    <render webgl="true" css3d="false" />
</krpano>
