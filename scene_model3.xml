<krpano version="1.20">
    <!-- Подключаем плагин. Путь относительный. Файл должен лежать в plugins/splats.js -->
    <include url="plugins/splats.js" />
    
    <scene name="scene_0" title="Zvon Splats">
        <view hlookat="0" vlookat="0" fov="90" />

        <!-- ВАЖНО: замени имя файла ниже на реальное имя твоего .spz файла в папке model -->
        <splats 
            url="model/my_splat_model.spz" 
            scale="1.0" 
            position="0 0 0" 
            rotation="0 0 0"
            visible="true"
            alpha="1.0"
        />

        <action name="onerror">
            trace('Ошибка загрузки модели: ', get(errormessage));
        </action>
    </scene>

    <render webgl="true" css3d="false" />
</krpano>
