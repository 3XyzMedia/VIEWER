<krpano version="1.20">
    <include url="%SWFPATH%/plugins/splats.js" />
    
    <scene name="scene_0" title="Zvon Splats">
        
        <view hlookat="0" vlookat="0" fov="90" />

        <!-- ВАЖНО: Используем прямую ссылку на скачивание -->
        <splats 
            url="https://drive.google.com/uc?export=download&amp;id=1sgY1--0OfsZR5taMo8PBhL3ynfWfe2_u" 
            scale="1.0" 
            position="0 0 0" 
            rotation="0 0 0"
            visible="true"
            alpha="1.0"
        />

        <action name="onerror">
            trace('Ошибка загрузки модели: ', get(errormessage));
        </action>
    </scene>

    <render webgl="true" css3d="false" />
</krpano>
