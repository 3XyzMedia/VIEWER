```xml
<krpano version="1.20">
    <include url="plugins/splats.js" />
    
    <scene name="scene_0" title="Zvon Splats">
        <view hlookat="0" vlookat="0" fov="90" />

        <splats
           url="https://github.com/3XyzMedia/VIEWER/releases/download/v1.0/zvon.ply"
           scale="1.0"
           position="0 0 0"
           rotation="0 0 0"
           visible="true"
           alpha="1.0"
        />

        <action name="onerror">
            trace('Ошибка загрузки модели: ', get(errormessage));
        </action>
    </scene>

    <render webgl="true" css3d="false" />
</krpano>
