,0.02601,0.14355,0.99216);}else{return vec4(0.54184,0.02336,0.18377,0.31765);}}else{if(i<987.0){return vec4(0.54189,-0.03676,0.07070,0.10196);}else{return vec4(0.54193,0.03456,0.17451,0.39608);}}}else{if(i<990.0){if(i<989.0){return vec4(0.54206,0.02695,0.11128,0.53725);}else{return vec4(0.54251,0.02799,0.14953,0.61176);}}else{if(i<991.0){return vec4(0.54259,-0.02829,0.10750,0.80392);}else{return vec4(0.54316,0.02910,0.11377,0.89412);}}}}}}else{if(i<1008.0){if(i<1000.0){if(i<996.0){if(i<994.0){if(i<993.0){return vec4(0.54380,-0.03109,0.15467,0.38039);}else{return vec4(0.54450,-0.02255,0.05885,0.88235);}}else{if(i<995.0){return vec4(0.54497,0.03263,0.13653,1.00000);}else{return vec4(0.54863,0.00664,0.05440,0.77255);}}}else{if(i<998.0){if(i<997.0){return vec4(0.55250,0.02898,0.05812,0.59608);}else{return vec4(0.55564,0.03983,0.19936,0.12549);}}else{if(i<999.0){return vec4(0.55603,-0.02514,0.23768,0.00000);}else{return vec4(0.55625,-0.00394,0.05265,0.84706);}}}}else{if(i<1004.0){if(i<1002.0){if(i<1001.0){return vec4(0.55660,-0.03869,0.16858,0.00000);}else{return vec4(0.55711,0.00947,0.24043,0.12941);}}else{if(i<1003.0){return vec4(0.55734,-0.04030,0.19392,0.00000);}else{return vec4(0.55862,-0.04041,0.12993,0.08627);}}}else{if(i<1006.0){if(i<1005.0){return vec4(0.55869,0.04092,0.18413,0.21569);}else{return vec4(0.55910,0.04117,0.11650,0.95294);}}else{if(i<1007.0){return vec4(0.55910,0.04119,0.11443,0.90980);}else{return vec4(0.56016,0.04240,0.12992,0.49804);}}}}}else{if(i<1016.0){if(i<1012.0){if(i<1010.0){if(i<1009.0){return vec4(0.56259,-0.02048,0.23363,0.00000);}else{return vec4(0.57379,-0.00432,0.22173,0.00000);}}else{if(i<1011.0){return vec4(0.57387,-0.00890,0.22092,0.00000);}else{return vec4(0.57698,0.02474,0.20315,0.00000);}}}else{if(i<1014.0){if(i<1013.0){return vec4(0.57704,-0.02098,0.20670,0.00000);}else{return vec4(0.57868,-0.02611,0.17450,0.00000);}}else{if(i<1015.0){return vec4(0.57909,-0.00941,0.20459,0.00000);}else{return vec4(0.57918,-0.02344,0.14453,0.023