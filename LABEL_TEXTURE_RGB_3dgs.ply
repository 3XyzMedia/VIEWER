  <!-- Mode 0: untouched; 1: burst; 2: vortex; 3: reveal; 4: rainbow reveal; 5: spiral tornado burst; 6: fire / embers / heat distortion.
       GLSL signature is taken from official krpano 1.24 splatshader example.
       Animation runs via JavaScript changing custom uniform values. -->
  <action name="xyz_fx46_shader" type="glsl"><![CDATA[
    uniform float fx_mode;
    uniform float fx_progress;
    uniform float fx_power;
    uniform float fx_radius;
    uniform float fx_rotx;
    uniform float fx_roty;
    uniform float fx_rotz;
    uniform float fx_logox;
    uniform float fx_logoy;
    uniform float fx_logoz;
    uniform float fx_labelsize;
    uniform float fx_textscale;

    float xyz_hash(vec3 p) {
      return fract(sin(dot(p, vec3(12.9898, 78.233, 37.719))) * 43758.5453);
    }
    vec3 xyz_palette(float t) {
      return 0.5 + 0.5 * cos(6.2831853 * (vec3(0.06,0.39,0.72) + t));
    }

    float xyz_fontrow(float glyph, float row) {
      float mask = 0.0;
      if (glyph < 0.5) {
        if (row < 0.5) mask = 31.0;
        else if (row < 1.5) mask = 1.0;
        else if (row < 2.5) mask = 1.0;
        else if (row < 3.5) mask = 15.0;
        else if (row < 4.5) mask = 1.0;
        else if (row < 5.5) mask = 1.0;
        else if (row < 6.5) mask = 31.0;
      }
      else if (glyph < 1.5) {
        if (row < 0.5) mask = 17.0;
        else if (row < 1.5) mask = 17.0;
        else if (row < 2.5) mask = 10.0;
        else if (row < 3.5) mask = 4.0;
        else if (row < 4.5) mask = 10.0;
        else if (row < 5.5) mask = 17.0;
        else if (row < 6.5) mask = 17.0;
      }
      else if (glyph < 2.5) {
        if (row < 0.5) mask = 0.0;
        else if (row < 1.5) mask = 0.0;
        else if (row < 2.5) mask = 17.0;
        else if (row < 3.5) mask = 17.0;
        else if (row < 4.5) mask = 15.0;
        else if (row < 5.5) mask = 1.0;
        else if (row < 6.5) mask = 14.0;
      }
      else if (glyph < 3.5) {
        if (row < 0.5) mask = 0.0;
        else if (row < 1.5) mask = 0.0;
        else if (row < 2.5) mask = 31.0;
        else if (row < 3.5) mask = 2.0;
        else if (row < 4.5) mask = 4.0;
        else if (row < 5.5) mask = 8.0;
        else if (row < 6.5) mask = 31.0;
      }
      else if (glyph < 4.5) {
        if (row < 0.5) mask = 17.0;
        else if (row < 1.5) mask = 27.0;
        else if (row < 2.5) mask = 21.0;
        else if (row < 3.5) mask = 21.0;
        else if (row < 4.5) mask = 17.0;
        else if (row < 5.5) mask = 17.0;
        else if (row < 6.5) mask = 17.0;
      }
      else if (glyph < 5.5) {
        if (row < 0.5) mask = 0.0;
        else if (row < 1.5) mask = 0.0;
        else if (row < 2.5) mask = 14.0;
        else if (row < 3.5) mask = 17.0;
        else if (row < 4.5) mask = 31.0;
        else if (row < 5.5) mask = 16.0;
        else if (row < 6.5) mask = 15.0;
      }
      else if (glyph < 6.5) {
        if (row < 0.5) mask = 1.0;
        else if (row < 1.5) mask = 1.0;
        else if (row < 2.5) mask = 15.0;
        else if (row < 3.5) mask = 17.0;
        else if (row < 4.5) mask = 17.0;
        else if (row < 5.5) mask = 17.0;
        else if (row < 6.5) mask = 15.0;
      }
      else if (glyph < 7.5) {
        if (row < 0.5) mask = 4.0;
        else if (row < 1.5) mask = 0.0;
        else if (row < 2.5) mask = 12.0;
        else if (row < 3.5) mask = 4.0;
        else if (row < 4.5) mask = 4.0;
        else if (row < 5.5) mask = 4.0;
        else if (row < 6.5) mask = 14.0;
      }
      else if (glyph < 8.5) {
        if (row < 0.5) mask = 0.0;
        else if (row < 1.5) mask = 0.0;
        else if (row < 2.5) mask = 14.0;
        else if (row < 3.5) mask = 1.0;
        else if (row < 4.5) mask = 15.0;
        else if (row < 5.5) mask = 17.0;
        else if (row < 6.5) mask = 15.0;
      }
      return mask;
    }
    bool xyz_fontpixel(float glyph, float col, float row) {
      float mask=xyz_fontrow(glyph,row);
      return mod(floor(mask/exp2(4.0-col)),2.0)>0.5;
